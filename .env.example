# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional client-side Gemini env vars
VITE_GEMINI_API_KEY=""
VITE_GEMINI_MODEL="gemini-2.5-flash"

# Firebase (optional: for shared campus leaderboard and remote profiles)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# Google Maps (browser key: Maps JavaScript API; restrict it to your site's URLs)
VITE_GOOGLE_MAPS_API_KEY=""
# Optional Google Cloud map ID (DEMO_MAP_ID is used otherwise)
VITE_GOOGLE_MAPS_MAP_ID=""
# Google Places API (New), used only by the server for kabadiwala and cleaner listings
GOOGLE_PLACES_API_KEY=""
